\lang1046\langfe1033\langnp1046\insrsid10184788 uma subst\'e2ncia org\'e2nica que d}{\lang1046\langfe1033\langnp1046\insrsid5841695 e}{\lang1046\langfe1033\langnp1046\insrsid10184788  cor a conquialina (treze por}{
\lang1046\langfe1033\langnp1046\insrsid5841695  }{\lang1046\langfe1033\langnp1046\insrsid10184788 cento), e \'e1gua (285 por cento). O carbonato de c\'e1lcio }{\lang1046\langfe1033\langnp1046\insrsid5841695 \'e9}{
\lang1046\langfe1033\langnp1046\insrsid10184788  um sal}{\lang1046\langfe1033\langnp1046\insrsid5841695  }{\lang1046\langfe1033\langnp1046\insrsid10184788 e usa-se habitualmente como anti}{\lang1046\langfe1033\langnp1046\insrsid5841695 \'e1}{
\lang1046\langfe1033\langnp1046\insrsid10184788 cido, absorvente e}{\lang1046\langfe1033\langnp1046\insrsid5841695   }{\lang1046\langfe1033\langnp1046\insrsid10184788 anti}{\lang1046\langfe1033\langnp1046\insrsid5841695  }{
\lang1046\langfe1033\langnp1046\insrsid10184788 diarr}{\lang1046\langfe1033\langnp1046\insrsid5841695 \'e9}{\lang1046\langfe1033\langnp1046\insrsid10184788 ico. Supus que o efeito anti}{\lang1046\langfe1033\langnp1046\insrsid8085810 \'e1}{
\lang1046\langfe1033\langnp1046\insrsid10184788 cido da p\'e9rola}{\lang1046\langfe1033\langnp1046\insrsid8085810  }{\lang1046\langfe1033\langnp1046\insrsid10184788 aliviaria a sua pesada digest\'e3o. E, lembrando-me de que }{
\lang1046\langfe1033\langnp1046\insrsid8085810 \'e9 }{\lang1046\langfe1033\langnp1046\insrsid10184788 insol\'favel em \'e1gua e  }{\lang1046\langfe1033\langnp1046\insrsid8085810 \'e1}{\lang1046\langfe1033\langnp1046\insrsid10184788 lcool, atrevi-me
 a recomendar-lhe que, no}{\lang1046\langfe1033\langnp1046\insrsid8085810  }{\lang1046\langfe1033\langnp1046\insrsid10184788 futuro, o tomasse diretamente. }{\lang1046\langfe1033\langnp1046\insrsid8085810 \tab }{
